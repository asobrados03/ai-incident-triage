# Configuración del backend de triaje de incidencias
# Backend de análisis: `fake` no necesita dependencias; descomenta `ollama` si
# tienes el runtime local disponible.
ANALYZER_BACKEND=fake
# ANALYZER_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=180

# Autenticación y tokens JWT (Access + Refresh tokens)
# Cambia estas credenciales antes de exponer la API fuera de localhost.
AUTH_USERS=admin:admin:admin-password-12345678,soporte:writer:soporte-pass-12345678,auditor:reader:auditor-pass-12345678
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres-seguro
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Bootstrap anónimo: solo para demos locales sin usuarios.
# Con `false`, si no hay AUTH_USERS ni usuarios en la BD, la API responde 401.
ALLOW_ANONYMOUS_BOOTSTRAP=false
