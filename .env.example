# Configuración del backend de triaje de incidencias
ANALYZER_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=180

# Autenticación y tokens JWT (Access + Refresh tokens)
AUTH_USERS=admin:admin:admin-password-12345678,soporte:writer:soporte-pass-12345678,auditor:reader:auditor-pass-12345678
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres-seguro
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
